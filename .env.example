# Credentials and database configuration — copy this file to .env and replace placeholders.
# Application settings (thresholds, brightness, cameras) are configured via admin panel & config.py.

# ⚠️  SECURITY: Use a strong, random secret (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# ⚠️  SECURITY: Change default admin credentials before deploying!
ADMIN_USER=replace-with-admin-username
ADMIN_PASS=replace-with-a-strong-admin-password

# Set to "true" to enable Flask debug mode (NEVER in production)
FLASK_DEBUG=false

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DATABASE=shopflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
